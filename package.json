{
  "name": "lasm-todomvc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TodoMVC in Lean (Lasm.UI), compiled to WebAssembly by Lasm, with an LLM chat panel that can read and change the list",
  "scripts": {
    "dev": "lasm dev Main.lean --target browser",
    "build": "lasm build Main.lean --target browser",
    "preview": "lasm dev Main.lean --target browser --release",
    "test": "playwright test"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@lasm/cli": "0.3.6",
    "@playwright/test": "1.64.1",
    "playwright": "1.64.1"
  }
}
